<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="kz.narrator.app.data.models.network.Resource" />

        <import type="kz.narrator.app.data.models.network.Status" />

        <import type="kz.narrator.app.ui.main_page.MainPageViewModel" />

        <variable
            name="viewModel"
            type="MainPageViewModel" />

        <variable
            name="anim"
            type="Integer" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/tv_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="audio found"
                    app:layout_constraintBottom_toTopOf="@id/btn_test"
                    app:layout_constraintEnd_toEndOf="@id/btn_test"
                    app:layout_constraintStart_toStartOf="@id/btn_test" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> viewModel.onTestAudioBtnClick()}"
                    android:text="Play_AUDIO"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> viewModel.onTestAudio2BtnClick()}"
                    android:text="CREATE_AUDIO"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_test" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> viewModel.onCreateVideoBtnClick()}"
                    android:text="CREATE_VVVIDEO"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_audio" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> viewModel.onAttachFileBtnClick()}"
                    android:text="SELECT_VIDEO"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_video" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GET_TIMESTAMPS"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_select" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> viewModel.onAnalyzeBtnClick()}"
                    android:text="LOGGER_TEST"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_timestamp" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_tester"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:constraint_referenced_ids="btn_audio,btn_logger,btn_select,btn_test,btn_timestamp,btn_video,tv_file"
                    app:visibleGone="@{viewModel.isTestVisible()}"
                    tools:visibility="gone" />

                <include
                    android:id="@+id/include_media_edit"
                    layout="@layout/view_media_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_20"
                    app:layout_constraintTop_toTopOf="parent"
                    app:viewModel="@{viewModel}" />

                <include
                    android:id="@+id/include_media_frame"
                    layout="@layout/view_media_frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_20"
                    app:layout_constraintTop_toBottomOf="@id/include_media_edit"
                    app:viewModel="@{viewModel}" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_media_edit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:constraint_referenced_ids="include_media_edit, include_media_frame"
                    app:visibleGone="@{viewModel.isMediaEditVisible()}"
                    tools:visibility="gone" />

                <include
                    android:id="@+id/include_media_settings"
                    layout="@layout/view_media_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_20"
                    app:layout_constraintTop_toBottomOf="@id/include_media_edit"
                    app:viewModel="@{viewModel}" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_media_settings"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:constraint_referenced_ids="include_media_settings"
                    app:visibleGone="@{viewModel.isMediaCreateVisible()}"
                    tools:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:rotation="-30"
                    android:src="@drawable/ic_name"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.32999998" />

                <ImageView
                    android:id="@+id/iv_number"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="150dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_name"
                    app:layout_constraintVertical_bias="0.18"
                    app:setAnim="@{anim}"
                    tools:src="@drawable/gif_number" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_splash"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:constraint_referenced_ids="iv_name,iv_number"
                    app:visibleGone="@{!viewModel.isMediaCreateVisible() &amp;&amp; !viewModel.isMediaEditVisible()}"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</layout>