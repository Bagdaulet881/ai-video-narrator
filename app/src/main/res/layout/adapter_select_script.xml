<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="kz.narrator.app.data.models.ai_data.ScriptAudioSettings" />

        <variable
            name="item"
            type="ScriptAudioSettings" />

        <variable
            name="recyclerViewItemClickCallback"
            type="kz.narrator.app.ui_common.callbacks.RecyclerViewItemClickCallback" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:onClick="@{() -> recyclerViewItemClickCallback.onRecyclerViewItemClick(item)}"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_state_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{item.name}"
            android:layout_margin="@dimen/dp_8"
            android:textSize="@dimen/sp_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Script Name"
            tools:textColor="@color/black" />

        <View
            android:background="@color/divider"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>