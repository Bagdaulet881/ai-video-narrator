<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/windowBg</item>
        <!--        <item name="android:forceDarkAllowed">true</item>-->
    </style>

    <!--Field-->

    <style name="CheckBoxShopsFilter" parent="Base.Theme.AppCompat">
        <item name="colorAccent">#FFFFFF</item> <!-- for uncheck state -->
        <item name="android:textColorSecondary">#FFFFFF</item> <!-- for check state -->
    </style>

    <style name="BottomSheetDialogStyle.Transparent" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="BottomSheetDialogTheme.Transparent" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetDialogStyle.Transparent</item>
    </style>

    <style name="ButtonStyleYellow" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/sp_18</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/dp_18</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingTop">@dimen/dp_18</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingBottom">@dimen/dp_18</item>
        <item name="backgroundTint">@color/btnColorRetro</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>
    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/shape_bg_bottom_sheet_dialog</item>
        <!--        <item name="android:layout_marginStart">@dimen/dp_14</item>-->
        <!--        <item name="android:layout_marginEnd">@dimen/dp_14</item>-->
        <!--        <item name="android:layout_marginTop">-14dp</item>-->
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">28dp</item> <!-- Adjust icon size -->
        <item name="itemTextAppearance">@style/BottomNavigationViewTextAppearance</item>
    </style>

    <style name="BottomNavigationViewTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item> <!-- Adjust text size -->
    </style>

</resources>
