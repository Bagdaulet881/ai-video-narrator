## Copy this file to local.properties and fill in your own values.
## local.properties is gitignored — never commit real keys.

# Path to your Android SDK (Android Studio usually writes this line for you).
sdk.dir=/path/to/Android/Sdk

# OpenAI API key — used for GPT-4 Vision to describe the selected video frame and write the narration.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# ElevenLabs API key — used for text-to-speech (model eleven_multilingual_v2).
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-key

# Path (relative to the project root) to a Google Cloud service-account JSON key with the
# Speech-to-Text API enabled — used to get word-level timestamps for the subtitles.
# At build time the file is base64-encoded into BuildConfig.GOOGLE_CLOUD_CREDENTIALS_BASE64.
GOOGLE_CLOUD_CREDENTIALS_FILE=secrets/google_cloud_credentials.json
